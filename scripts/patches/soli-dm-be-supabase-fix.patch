+import { describe, it, expect, beforeEach, afterEach } from "vitest";
+import { formatRouteError } from "./routeError";
+
+describe("formatRouteError", () => {
+  const prevUrl = process.env.SUPABASE_URL;
+  const prevKey = process.env.SUPABASE_SERVICE_KEY;
+
+  afterEach(() => {
+    if (prevUrl === undefined) delete process.env.SUPABASE_URL;
+    else process.env.SUPABASE_URL = prevUrl;
+    if (prevKey === undefined) delete process.env.SUPABASE_SERVICE_KEY;
+    else process.env.SUPABASE_SERVICE_KEY = prevKey;
+  });
+
+  it("restituisce 503 se Supabase non è configurato", () => {
+    delete process.env.SUPABASE_URL;
+    delete process.env.SUPABASE_SERVICE_KEY;
+
+    const result = formatRouteError(new Error("anything"));
+    expect(result.status).toBe(503);
+    expect(result.message).toMatch(/Database non configurato/);
+  });
+
+  it("mappa fetch failed in errore database non raggiungibile", () => {
+    process.env.SUPABASE_URL = "https://test-project.supabase.co";
+    process.env.SUPABASE_SERVICE_KEY = "x".repeat(40);
+
+    const result = formatRouteError(new Error("TypeError: fetch failed"));
+    expect(result.status).toBe(503);
+    expect(result.message).toMatch(/non raggiungibile/);
+  });
+
+  it("propaga altri errori come 500", () => {
+    process.env.SUPABASE_URL = "https://test-project.supabase.co";
+    process.env.SUPABASE_SERVICE_KEY = "x".repeat(40);
+
+    const result = formatRouteError(new Error("connection refused"));
+    expect(result.status).toBe(500);
+    expect(result.message).toBe("connection refused");
+  });
+});
diff --git a/src/lib/routeError.ts b/src/lib/routeError.ts
new file mode 100644
index 0000000..7d55109
--- /dev/null
+++ b/src/lib/routeError.ts
@@ -0,0 +1,45 @@
+import type { Response } from "express";
+import { isSupabaseConfigured } from "./supabaseConfig";
+
+export function formatRouteError(err: unknown): {
+  status: number;
+  message: string;
+} {
+  if (!isSupabaseConfigured()) {
+    return {
+      status: 503,
+      message:
+        "Database non configurato: imposta SUPABASE_URL e SUPABASE_SERVICE_KEY sul server.",
+    };
+  }
+
+  const message =
+    err && typeof err === "object" && "message" in err
+      ? String((err as { message?: unknown }).message ?? "Errore database")
+      : String(err ?? "Errore database");
+
+  const lower = message.toLowerCase();
+  if (
+    lower.includes("fetch failed") ||
+    lower.includes("enotfound") ||
+    lower.includes("econnrefused") ||
+    lower.includes("network")
+  ) {
+    return {
+      status: 503,
+      message:
+        "Database non raggiungibile: verifica SUPABASE_URL e che il progetto Supabase sia attivo.",
+    };
+  }
+
+  return { status: 500, message };
+}
+
+export function sendRouteError(
+  res: Response,
+  err: unknown,
+  fallbackStatus = 500
+): void {
+  const formatted = formatRouteError(err);
+  res.status(formatted.status || fallbackStatus).json({ error: formatted.message });
+}
