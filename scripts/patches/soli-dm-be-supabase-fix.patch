diff --git a/src/lib/supabaseConfig.ts b/src/lib/supabaseConfig.ts
new file mode 100644
index 0000000..05ee316
--- /dev/null
+++ b/src/lib/supabaseConfig.ts
@@ -0,0 +1,80 @@
+export type SupabaseEnv = {
+  url: string;
+  serviceKey: string;
+};
+
+function normalizeEnv(value: string | undefined): string {
+  if (value == null) return "";
+  const trimmed = String(value).trim();
+  if (
+    (trimmed.startsWith('"') && trimmed.endsWith('"')) ||
+    (trimmed.startsWith("'") && trimmed.endsWith("'"))
+  ) {
+    return trimmed.slice(1, -1).trim();
+  }
+  return trimmed;
+}
+
+function isValidHttpUrl(value: string): boolean {
+  if (!value) return false;
+  try {
+    const u = new URL(value);
+    return u.protocol === "https:" || u.protocol === "http:";
+  } catch {
+    return false;
+  }
+}
+
+function looksLikePlaceholderUrl(url: string): boolean {
+  const lower = url.toLowerCase();
+  return lower.includes("your-project") || lower.includes("placeholder");
+}
+
+function looksLikePlaceholderKey(key: string): boolean {
+  if (key.length < 32) return true;
+  const lower = key.toLowerCase();
+  return (
+    lower.includes("your-service") ||
+    lower.includes("placeholder") ||
+    lower.includes("changeme")
+  );
+}
+
+export function readSupabaseEnv(): SupabaseEnv {
+  return {
+    url: normalizeEnv(process.env.SUPABASE_URL),
+    serviceKey: normalizeEnv(process.env.SUPABASE_SERVICE_KEY),
+  };
+}
+
+export function getSupabaseConfigIssues(env: SupabaseEnv = readSupabaseEnv()): string[] {
+  const issues: string[] = [];
+
+  if (!env.url) {
+    issues.push("SUPABASE_URL mancante");
+  } else if (!isValidHttpUrl(env.url)) {
+    issues.push("SUPABASE_URL non è un URL HTTP valido");
+  } else if (looksLikePlaceholderUrl(env.url)) {
+    issues.push("SUPABASE_URL sembra un placeholder da .env.example");
+  }
+
+  if (!env.serviceKey) {
+    issues.push("SUPABASE_SERVICE_KEY mancante");
+  } else if (looksLikePlaceholderKey(env.serviceKey)) {
+    issues.push("SUPABASE_SERVICE_KEY sembra un placeholder da .env.example");
+  }
+
+  return issues;
+}
+
+export function isSupabaseConfigured(env: SupabaseEnv = readSupabaseEnv()): boolean {
+  return getSupabaseConfigIssues(env).length === 0;
+}
+
+export function getSupabaseStatusSummary() {
+  const issues = getSupabaseConfigIssues();
+  return {
+    configured: issues.length === 0,
+    ...(issues.length > 0 ? { issues } : {}),
+  };
+}
